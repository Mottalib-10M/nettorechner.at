---
/**
 * Startseite (Säule, RECETTE §5): Rechner zuerst, dann der zitierbare Absatz, die Änderungen 2026 als Liste,
 * die Netto-Tabelle aus dem Motor und der Text aus src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import BruttoNettoRechner from './calc/BruttoNettoRechner';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, type Locale } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { P, type SourceKey } from '../lib/engine/params';
import { kurz } from '../lib/engine/leistungen';
import { svLaufend } from '../lib/engine/lohn';
import { BMF_FAELLE } from '../lib/pruefung';
import { formatMoney, formatPercent, displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../data/site-config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const de = lang === 'de';
const x = HOME[lang];
const h = helpers(lang);
const path = route('home', lang);
const parts = x.body(h).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const faqs = x.faqs(h);
const keys: SourceKey[] = ['estg33', 'estg67', 'estg16', 'estg124b', 'bmfPresse', 'bmfRechner', 'bmfPendlerrechner', 'oegkWerte', 'oegkAv', 'oegkWfWien', 'wienWbf', 'wkoBeitraege'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const $ = (n: number, d = 0) => formatMoney(n, d, lang);
const pc = (n: number, d = 2) => formatPercent(n, d, lang);
const betraege = [1500, 2000, 2500, 3000, 3500, 4000, 5000, 6000, 7000, 10000];
const seiten: Record<number, string> = { 1500: 'netto-1500', 2000: 'netto-2000', 2500: 'netto-2500', 3000: 'netto-3000', 3500: 'netto-3500', 4000: 'netto-4000', 5000: 'netto-5000', 6000: 'netto-6000', 7000: 'netto-7000', 10000: 'netto-10000' };
const zeilen = betraege.map((b) => { const k = kurz(b); return { b, k, w: kurz(b, { wien: true }).nettoMonat, href: route(seiten[b], lang) }; });
const neu2026 = de ? [
  ['Steuertarif', `Alle Grenzen um ${pc(P.tarif.indexierung_2026)} angehoben; steuerfrei bleiben die ersten ${$(P.tarif.grenzen[0])} im Jahr.`],
  ['Pendlereuro', `${$(P.absetzbetraege.pendlereuro_je_km)} statt ${$(P.absetzbetraege.pendlereuro_je_km_2025)} je Kilometer der einfachen Strecke.`],
  ['Wien', `Wohnbauförderungsbeitrag ${pc(P.sv.dn.wf_wien)} statt ${pc(P.sv.dn.wf, 1)} für Dienstnehmer und Dienstgeber.`],
  ['Überstunden', `Steuerfreie Zuschläge für ${P.ueberstunden.frei_stunden_2026} statt ${P.ueberstunden.frei_stunden_2024_2025} Überstunden, höchstens ${$(P.ueberstunden.frei_max_2026)} im Monat.`],
  ['Geringfügigkeit', `Grenze erstmals nicht angehoben: ${$(P.sv.geringfuegigkeit, 2)} im Monat.`],
  ['Arbeitslosenversicherung', `Kein Beitrag bis ${$(P.sv.av_staffel[0][0])}, voller Satz erst über ${$(P.sv.av_staffel[2][0])}.`],
] : [
  ['Tax scale', `All brackets raised by ${pc(P.tarif.indexierung_2026)}; the first ${$(P.tarif.grenzen[0])} a year stay tax-free.`],
  ['Commuter euro', `${$(P.absetzbetraege.pendlereuro_je_km)} instead of ${$(P.absetzbetraege.pendlereuro_je_km_2025)} per kilometre of the one-way distance.`],
  ['Vienna', `Housing-subsidy contribution ${pc(P.sv.dn.wf_wien)} instead of ${pc(P.sv.dn.wf, 1)} for employees and employers.`],
  ['Overtime', `Tax-free premiums for ${P.ueberstunden.frei_stunden_2026} instead of ${P.ueberstunden.frei_stunden_2024_2025} overtime hours, at most ${$(P.ueberstunden.frei_max_2026)} a month.`],
  ['Marginal jobs', `Limit frozen for the first time at ${$(P.sv.geringfuegigkeit, 2)} a month.`],
  ['Unemployment insurance', `No contribution up to ${$(P.sv.av_staffel[0][0])}, full rate only above ${$(P.sv.av_staffel[2][0])}.`],
];
const rechner = ['netto-brutto', 'sonderzahlungen', 'pendlerpauschale', 'familienbonus', 'ueberstunden', 'arbeitslosengeld', 'kinderbetreuungsgeld', 'abfertigung', 'dienstgeberkosten', 'wien'];
import { label } from '../i18n/nav';
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-5">
    <h1 class="text-3xl font-bold text-navy-900 md:text-[2.6rem] md:leading-tight">{x.h1}</h1>
    <p class="mt-3 max-w-none text-lg text-navy-700">{x.intro}</p>
    <p class="mt-3 text-sm text-navy-700">
      {de ? 'Werte 2026, geprüft am' : '2026 values, checked on'} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, LANG_TAGS[lang])}</time> · {de ? `${BMF_FAELLE} Fälle wie der BMF-Rechner` : `${BMF_FAELLE} cases identical to the BMF calculator`} · <a class="underline" href={route('method', lang)}>{label('method', lang)}</a> · <a class="underline" href={route('about', lang)}>{label('about', lang)}</a>
    </p>
  </header>
  <div data-outil><BruttoNettoRechner client:load lang={lang} methodHref={route('method', lang)} /></div>
  <section class="mt-10" aria-labelledby="kurz">
    <h2 id="kurz" class="sr-only">{de ? 'Das Wichtigste in Kürze' : 'In short'}</h2>
    <Clamp text={x.resume(h)} lang={lang} id="clamp-home" sentences={2} />
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="neu">
    <h2 id="neu" class="text-2xl font-bold text-navy-900">{de ? 'Was sich 2026 im Lohnzettel ändert' : 'What changes on the 2026 payslip'}</h2>
    <dl class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">
      {neu2026.map(([k, v]) => <div class="border-l-2 border-accent-600 pl-3"><dt class="font-semibold text-navy-900">{k}</dt><dd class="text-navy-700">{v}</dd></div>)}
    </dl>
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="tabelle">
    <h2 id="tabelle" class="text-2xl font-bold text-navy-900">{de ? 'Netto-Tabelle 2026: zehn Gehälter im Vergleich' : '2026 net pay table: ten salaries compared'}</h2>
    <p class="mt-2 text-navy-700">{de ? 'Angestellte oder Arbeiter, 14 Bezüge, ohne Kinder und ohne Pendlerpauschale. Jede Zeile führt zur Seite des Betrags.' : 'Employee with 14 payments, no children, no commuter allowance. Each row links to the page for that amount.'}</p>
    <div class="not-prose my-4 overflow-x-auto">
      <table class="journal w-full text-sm">
        <thead><tr><th scope="col" class="py-2 text-left">{de ? 'Brutto/Monat' : 'Gross/month'}</th><th scope="col" class="text-right">{de ? 'SV' : 'Soc. ins.'}</th><th scope="col" class="text-right">{de ? 'Lohnsteuer' : 'Wage tax'}</th><th scope="col" class="text-right">{de ? 'Netto/Monat' : 'Net/month'}</th><th scope="col" class="text-right">{de ? 'Netto Wien' : 'Net Vienna'}</th><th scope="col" class="text-right">{de ? 'Netto/Jahr' : 'Net/year'}</th></tr></thead>
        <tbody>{zeilen.map((z) => <tr class="border-t border-navy-100"><th scope="row" class="py-1.5 text-left font-medium"><a class="underline" href={z.href}>{$(z.b)}</a></th><td class="tabular-nums text-right">{$(z.k.svMonat, 2)}</td><td class="tabular-nums text-right">{$(z.k.lstMonat, 2)}</td><td class="tabular-nums text-right font-semibold">{$(z.k.nettoMonat, 2)}</td><td class="tabular-nums text-right">{$(z.w, 2)}</td><td class="tabular-nums text-right">{$(z.k.nettoJahr)}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="text-sm text-navy-600">{de ? `Ab ${$(P.sv.hbg_monat)} bleibt die Sozialversicherung gleich (Höchstbeitragsgrundlage), deshalb steigt das Netto darüber schneller.` : `From ${$(P.sv.hbg_monat)} social insurance stays flat (contribution ceiling), so net pay rises faster above it.`} {svLaufend(P.sv.hbg_monat).summe > 0 && ''}</p>
  </section>
  <div class="prose prose-slate mt-10 max-w-none border-t border-navy-200 pt-4">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={route('sonderzahlungen', lang)} />)}
  </div>
  <aside class="mt-10 rounded-xl border border-navy-200 p-5" aria-labelledby="alle" data-chrome>
    <h2 id="alle" class="text-xl font-bold text-navy-900">{de ? 'Alle Rechner auf einen Blick' : 'All calculators at a glance'}</h2>
    <ul class="mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">{rechner.map((id) => <li><a class="text-accent-700 underline" href={route(id, lang)}>{label(id, lang)}</a></li>)}</ul>
  </aside>
</PageLayout>
