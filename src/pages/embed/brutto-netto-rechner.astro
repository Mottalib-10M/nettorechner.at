---
/** Einbettbare Seite (iframe): Rechner ohne Navigation. noindex, nicht in der Sitemap (astro.config). */
import '../../styles/global.css';
import BruttoNettoRechner from '../../components/calc/BruttoNettoRechner';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brutto-Netto-Rechner Österreich 2026</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/de/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <BruttoNettoRechner client:load lang="de" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/de/`} target="_blank" rel="noopener" class="underline">Brutto-Netto-Rechner Österreich 2026</a></p>
  </body>
</html>
